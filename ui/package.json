{
  "name": "blackboardxray-ui",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "check": "node scripts/check-raw-values.mjs",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run tokens && npm run check && npm run contrast && npm run typecheck"
  },
