# One line ending everywhere, decided here rather than by whichever machine
# checked the file out.
* text=auto eol=lf

# Generated. Marked so a diff view collapses them and a language survey does not
# count them as something somebody wrote.
CHANGELOG.md      linguist-generated=true
uv.lock           linguist-generated=true -diff
ui/package-lock.json linguist-generated=true -diff
ui/src/styles/tokens.css linguist-generated=true -diff
ui/src/styles/theme.css  linguist-generated=true -diff
ui/tokens/primitive/color.json linguist-generated=true -diff

# Not the product. The interface's own source is, but its lockfile is not, and
# the fixtures are not.
examples/**   linguist-documentation=true
docs/**       linguist-documentation=true

*.png binary
*.woff2 binary
